@model RaceDay.Web.Controllers.ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}
<div class="rd-empty my-5">
    <div class="rd-empty-icon"><i class="bi bi-cone-striped"></i></div>
    <h1 class="rd-h2">We hit a pothole</h1>
    <p class="text-muted">Something unexpected happened on our side. Please try again, or head back to safety.</p>
    <a href="/" class="btn btn-rd-primary"><i class="bi bi-house-fill"></i> Back to start</a>
    @if (!string.IsNullOrEmpty(Model?.RequestId))
    {
        <p class="small text-muted mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
    }
</div>
