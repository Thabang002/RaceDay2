@model List<EventModel>
@{
    ViewData["Title"] = "Find your next race";
}
<section class="rd-hero">
    <div class="row align-items-center g-4 position-relative" style="z-index:1">
        <div class="col-lg-7">
            <span class="rd-chip rd-chip-lime mb-3"><i class="bi bi-lightning-charge-fill"></i> South Africa's race-day platform</span>
            <h1 class="rd-display mb-3">Find it.<br />Run it. <span class="text-orange">Own it.</span></h1>
            <p class="lead mb-4">Discover road races, trail runs, rides and tris near you. Enter in seconds, track your enrolments and keep every finish time in one place.</p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Account" asp-action="Register" class="btn btn-rd-primary btn-lg"><i class="bi bi-person-plus-fill"></i> Join as a participant</a>
                <a asp-controller="Account" asp-action="Register" asp-route-role="Organiser" class="btn btn-outline-light btn-lg"><i class="bi bi-flag-fill"></i> I organise events</a>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3">
                <div class="col-6"><div class="rd-card rd-stat rd-stat-accent"><div class="rd-stat-label">Upcoming races</div><div class="rd-stat-value">@(Model.Count == 6 ? "6+" : Model.Count.ToString())</div><div class="rd-stat-icon"><i class="bi bi-calendar-event"></i></div></div></div>
                <div class="col-6"><div class="rd-card rd-stat rd-stat-accent"><div class="rd-stat-label">Enter in</div><div class="rd-stat-value">30s</div><div class="rd-stat-icon"><i class="bi bi-stopwatch"></i></div></div></div>
                <div class="col-12"><div class="rd-card rd-stat rd-stat-accent"><div class="rd-stat-label">Every result, ranked</div><div class="rd-stat-value">Time · Place · Pace</div><div class="rd-stat-icon"><i class="bi bi-trophy"></i></div></div></div>
            </div>
        </div>
    </div>
</section>

<div class="d-flex justify-content-between align-items-end mb-3">
    <div>
        <div class="rd-kicker">On the start list</div>
        <h2 class="rd-h2 mb-0">Upcoming events</h2>
    </div>
    <a asp-controller="Account" asp-action="Login" class="btn btn-rd-outline">Log in to enter <i class="bi bi-arrow-right"></i></a>
</div>

@if (ViewBag.ApiDown == true)
{
    <div class="rd-card rd-empty"><div class="rd-empty-icon"><i class="bi bi-wifi-off"></i></div><p class="mb-0 text-muted">Events can't be loaded right now. Please try again shortly.</p></div>
}
else if (!Model.Any())
{
    <div class="rd-card rd-empty"><div class="rd-empty-icon"><i class="bi bi-calendar-x"></i></div><p class="mb-0 text-muted">No upcoming events yet - check back soon.</p></div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_EventCard" model="@(ev, false, Url.Action("Login", "Account", new { returnUrl = $"/Participant/Events/Details/{ev.EventId}" })!)" />
            </div>
        }
    </div>
}
