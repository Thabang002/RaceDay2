@model OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var first = Model.OrganiserName.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Organiser";
    var next = Model.Upcoming.FirstOrDefault();
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 rd-page-header">
    <div>
        <div class="rd-kicker">Race Control</div>
        <h1 class="rd-h1">Hey @first, here's your race day overview</h1>
        <p class="text-muted mb-0">Everything happening across the events you organise.</p>
    </div>
    <a href="/Organiser/Events/Create" class="btn btn-rd-primary"><i class="bi bi-plus-lg"></i> Create event</a>
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="rd-card rd-stat rd-stat-accent h-100">
            <div class="rd-stat-label">Events created</div>
            <div class="rd-stat-value">@Model.TotalEvents</div>
            <div class="rd-stat-icon"><i class="bi bi-flag-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="rd-card rd-stat h-100">
            <div class="rd-stat-label">Total enrolments</div>
            <div class="rd-stat-value">@Model.TotalEnrolments</div>
            <div class="rd-stat-icon"><i class="bi bi-people-fill"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="rd-card rd-stat h-100">
            <div class="rd-stat-label">Confirmed</div>
            <div class="rd-stat-value">@Model.ConfirmedEnrolments</div>
            <div class="rd-stat-icon"><i class="bi bi-check2-circle"></i></div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="rd-card rd-stat h-100">
            <div class="rd-stat-label">Upcoming events</div>
            <div class="rd-stat-value">@Model.Upcoming.Count</div>
            <div class="rd-stat-icon"><i class="bi bi-calendar-event"></i></div>
        </div>
    </div>
</div>

@if (!Model.Events.Any())
{
    <div class="rd-card rd-empty">
        <div class="rd-empty-icon"><i class="bi bi-flag"></i></div>
        <h2 class="rd-h2">No events yet</h2>
        <p class="text-muted">Create your first event, add categories, and participants can start enrolling straight away.</p>
        <a href="/Organiser/Events/Create" class="btn btn-rd-primary"><i class="bi bi-plus-lg"></i> Create your first event</a>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-xl-8">
            <div class="rd-card h-100">
                <div class="rd-card-header">
                    <h2 class="rd-h3">All my events</h2>
                    <a href="/Organiser/Events" class="small fw-semibold">Manage <i class="bi bi-arrow-right"></i></a>
                </div>
                <div class="table-responsive">
                    <table class="table rd-table">
                        <thead>
                            <tr><th>Event</th><th>Date</th><th>Enrolments</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                        @foreach (var e in Model.Events.OrderBy(x => x.IsUpcoming ? 0 : 1).ThenBy(x => x.IsUpcoming ? x.Date.Ticks : -x.Date.Ticks))
                        {
                            <tr>
                                <td>
                                    <a href="/Organiser/Events/Details/@e.EventId" class="rd-cell-title text-decoration-none">@e.Title</a>
                                    <div class="small text-muted">@e.EventType · @Ui.Km(e.DistanceKm) · @e.CategoryCount @(e.CategoryCount == 1 ? "category" : "categories")</div>
                                </td>
                                <td class="text-nowrap">@Ui.ShortDate(e.Date)<div class="small text-muted">@Ui.Clock(e.StartTime)</div></td>
                                <td style="min-width:170px">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <strong>@e.EnrolmentCount <span class="text-muted fw-normal">/ @e.MaxParticipants</span></strong>
                                        <span class="text-muted">@e.ConfirmedCount confirmed</span>
                                    </div>
                                    <div class="progress rd-progress" role="progressbar" aria-label="Enrolments" aria-valuenow="@e.FillPercent" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width:@(e.FillPercent)%"></div>
                                    </div>
                                </td>
                                <td><partial name="_StatusBadge" model="@(e.ResultsPublished ? "Completed" : e.Status)" /></td>
                                <td class="text-end"><a href="/Organiser/Enrolments?eventId=@e.EventId" class="btn btn-sm btn-rd-outline btn-icon" title="View enrolments" aria-label="View enrolments for @e.Title"><i class="bi bi-people"></i></a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-xl-4 d-flex flex-column gap-4">
            @if (next != null)
            {
                <div class="rd-hero rd-hero-slim mb-0">
                    <div class="rd-kicker text-white-50">Next on the calendar</div>
                    <h2 class="rd-display" style="font-size:2rem">@next.Title</h2>
                    <p class="mb-3"><i class="bi bi-calendar3"></i> @Ui.Date(next.Date) · @Ui.Clock(next.StartTime)<br /><i class="bi bi-geo-alt-fill"></i> @next.LocationName</p>
                    <span class="rd-chip rd-chip-lime"><i class="bi bi-stopwatch"></i> @Ui.DaysToGo(next.Date)</span>
                </div>
            }

            <div class="rd-card">
                <div class="rd-card-header"><h2 class="rd-h3">Upcoming dates</h2></div>
                <ul class="list-group list-group-flush">
                    @foreach (var e in Model.Upcoming.Take(6))
                    {
                        <li class="list-group-item d-flex align-items-center gap-3 py-3">
                            <div class="rd-date-badge"><span class="d">@e.Date.Day</span><span class="m">@e.Date.ToString("MMM", Ui.Culture)</span></div>
                            <div class="flex-grow-1 min-w-0">
                                <a href="/Organiser/Events/Details/@e.EventId" class="fw-semibold text-navy text-decoration-none d-block text-truncate">@e.Title</a>
                                <span class="small text-muted">@e.EnrolmentCount enrolled · @Ui.DaysToGo(e.Date)</span>
                            </div>
                        </li>
                    }
                    @if (!Model.Upcoming.Any())
                    {
                        <li class="list-group-item text-muted small py-3">No upcoming events.</li>
                    }
                </ul>
            </div>

            @if (Model.AwaitingResults.Any())
            {
                <div class="rd-card">
                    <div class="rd-card-header"><h2 class="rd-h3"><i class="bi bi-stopwatch text-orange"></i> Results to capture</h2></div>
                    <ul class="list-group list-group-flush">
                        @foreach (var e in Model.AwaitingResults)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center py-3">
                                <span class="small"><strong>@e.Title</strong><br /><span class="text-muted">@Ui.ShortDate(e.Date)</span></span>
                                <a href="/Organiser/Results?eventId=@e.EventId" class="btn btn-sm btn-rd-primary">Capture</a>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
}
