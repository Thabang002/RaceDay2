@model CategoryFormViewModel
@{
    var ev = (EventModel)ViewBag.Event;
    ViewData["Title"] = "Edit category";
    ViewData["Tab"] = "Categories";
    var enrolled = ViewBag.EnrolledCount as int? ?? 0;
}
<partial name="_EventSubNav" model="ev" />

<div class="row justify-content-center">
    <div class="col-lg-7">
        <form asp-action="Edit" asp-route-id="@Model.CategoryId" method="post" novalidate class="rd-card">
            <div class="rd-card-header"><h2 class="rd-h3">Edit category</h2>@if (enrolled > 0) { <span class="rd-chip">@enrolled enrolled</span> }</div>
            <div class="rd-card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger rd-alert"></div>
                <input type="hidden" asp-for="EventId" />
                <input type="hidden" asp-for="CategoryId" />
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <input asp-for="Description" class="form-control" />
                </div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="DistanceKm" class="form-label"></label>
                        <input asp-for="DistanceKm" class="form-control" type="number" step="0.1" min="0" />
                        <span asp-validation-for="DistanceKm" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StartFee" class="form-label"></label>
                        <input asp-for="StartFee" class="form-control" type="number" step="0.01" min="0" />
                        <span asp-validation-for="StartFee" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="MaxParticipants" class="form-label"></label>
                        <input asp-for="MaxParticipants" class="form-control" type="number" min="@Math.Max(1, enrolled)" />
                        <span asp-validation-for="MaxParticipants" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="rd-card-header border-top border-bottom-0 justify-content-end gap-2">
                <a href="/Organiser/Categories?eventId=@Model.EventId" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-rd-primary"><i class="bi bi-check2-circle"></i> Save category</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
