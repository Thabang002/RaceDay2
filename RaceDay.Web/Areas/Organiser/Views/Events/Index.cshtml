@model List<OrganiserEventSummary>
@{
    ViewData["Title"] = "My events";
}
<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 rd-page-header">
    <div>
        <div class="rd-kicker">Events management</div>
        <h1 class="rd-h1">My events</h1>
        <p class="text-muted mb-0">Create, edit and delete your events, and jump into categories, enrolments and results.</p>
    </div>
    <a href="/Organiser/Events/Create" class="btn btn-rd-primary"><i class="bi bi-plus-lg"></i> Create event</a>
</div>

@if (!Model.Any())
{
    <div class="rd-card rd-empty">
        <div class="rd-empty-icon"><i class="bi bi-flag"></i></div>
        <h2 class="rd-h2">No events yet</h2>
        <p class="text-muted">Your events will show up here.</p>
        <a href="/Organiser/Events/Create" class="btn btn-rd-primary"><i class="bi bi-plus-lg"></i> Create event</a>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr><th>Event</th><th>Type</th><th>Date</th><th>Location</th><th class="text-center">Enrolled</th><th>Status</th><th class="text-end">Actions</th></tr>
                </thead>
                <tbody>
                @foreach (var e in Model.OrderByDescending(x => x.IsUpcoming).ThenBy(x => x.Date))
                {
                    <tr>
                        <td>
                            <a href="/Organiser/Events/Details/@e.EventId" class="rd-cell-title text-decoration-none">@e.Title</a>
                            <div class="small text-muted">@Ui.Km(e.DistanceKm)</div>
                        </td>
                        <td><span class="rd-chip"><i class="bi @Ui.EventTypeIcon(e.EventType)"></i> @(e.EventType ?? "—")</span></td>
                        <td class="text-nowrap">@Ui.ShortDate(e.Date)<div class="small text-muted">@Ui.Clock(e.StartTime)</div></td>
                        <td>@e.LocationName</td>
                        <td class="text-center"><strong>@e.EnrolmentCount</strong><span class="text-muted">/@e.MaxParticipants</span></td>
                        <td><partial name="_StatusBadge" model="@(e.ResultsPublished ? "Completed" : e.Status)" /></td>
                        <td class="text-end text-nowrap">
                            <div class="btn-group">
                                <a href="/Organiser/Events/Edit/@e.EventId" class="btn btn-sm btn-rd-outline btn-icon" title="Edit" aria-label="Edit @e.Title"><i class="bi bi-pencil"></i></a>
                                <a href="/Organiser/Categories?eventId=@e.EventId" class="btn btn-sm btn-rd-outline btn-icon" title="Categories" aria-label="Categories for @e.Title"><i class="bi bi-tags"></i></a>
                                <a href="/Organiser/Enrolments?eventId=@e.EventId" class="btn btn-sm btn-rd-outline btn-icon" title="Enrolments" aria-label="Enrolments for @e.Title"><i class="bi bi-people"></i></a>
                                <a href="/Organiser/Results?eventId=@e.EventId" class="btn btn-sm btn-rd-outline btn-icon" title="Results" aria-label="Results for @e.Title"><i class="bi bi-stopwatch"></i></a>
                            </div>
                            <form asp-action="Delete" asp-route-id="@e.EventId" method="post" class="d-inline"
                                  data-confirm="Delete &quot;@e.Title&quot;? Participants will no longer see this event." data-confirm-button="Delete event">
                                <button type="submit" class="btn btn-sm btn-outline-danger btn-icon ms-1" title="Delete" aria-label="Delete @e.Title"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
